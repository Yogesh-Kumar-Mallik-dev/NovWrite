// ==============================================================================
// NovWrite Database Schema (Prisma)
// Block Standard: BLOCK_DB_PRISMA_SCHEMA_002
// Version: 2.0 (First & Second Class Blueprints, Relational Entity Graph,
//                Dual-Valued Enums, Formulas & Column Preferences)
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectRole {
  LEAD_AUTHOR
  CO_AUTHOR
  EDITOR
  CONTRIBUTOR
  VIEWER
}

enum BlueprintClass {
  FIRST_CLASS
  SECOND_CLASS
}

enum BlueprintFieldType {
  STRING
  NUMBER
  BOOLEAN
  ENUM
  BLUEPRINT_REF
  FORMULA
}

enum InvariantSeverity {
  BLOCKING_ERROR
  WARNING
  ADVISORY_NOTE
}

enum EffectOperation {
  SET
  INCREMENT
  DECREMENT
  APPEND
  REMOVE
  TRANSFER
}

model User {
  id               String      @id @default(uuid()) @db.Uuid
  email            String      @unique @db.VarChar(255)
  username         String      @unique @db.VarChar(100)
  passwordHash     String      @map("password_hash") @db.VarChar(255)
  isPlatformAdmin  Boolean     @default(false) @map("is_platform_admin")
  mfaEnabled       Boolean     @default(false) @map("mfa_enabled")
  mfaSecret        String?     @map("mfa_secret") @db.VarChar(255)
  stripeCustomerId String?     @map("stripe_customer_id") @db.VarChar(255)
  accountStatus    String      @default("ACTIVE") @map("account_status") @db.VarChar(50)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  ownedProjects       Project[]                        @relation("ProjectOwner")
  projectMemberships  ProjectMember[]
  adminOverrideLogs   AdminOverrideLog[]
  platformAuditLogs   PlatformAdminAuditLog[]          @relation("AdminUser")
  targetPlatformLogs  PlatformAdminAuditLog[]          @relation("TargetUser")
  sceneLeases         SceneLease[]
  columnPreferences   UserBlueprintColumnPreference[]

  @@map("users")
}

model PlatformAdminAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  adminUserId  String   @map("admin_user_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  actionType   String   @map("action_type") @db.VarChar(100)
  ticketId     String?  @map("ticket_id") @db.VarChar(100)
  details      Json     @default("{}") @db.JsonB
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  adminUser    User     @relation("AdminUser", fields: [adminUserId], references: [id], onDelete: Restrict)
  targetUser   User?    @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([actionType])
  @@map("platform_admin_audit_logs")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  genre       String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner               User                             @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members             ProjectMember[]
  blueprints          Blueprint[]
  blueprintFields     BlueprintField[]
  columnPreferences   UserBlueprintColumnPreference[]
  entities            Entity[]
  entityRelationships EntityRelationship[]
  timelineEvents      TimelineEvent[]
  eventEffects        EventEffect[]
  stateSnapshots      StateSnapshot[]
  invariantRules      InvariantRule[]
  ruleViolations      RuleViolation[]
  manuscripts         Manuscript[]
  adminOverrideLogs   AdminOverrideLog[]

  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole @default(CONTRIBUTOR)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Blueprint {
  id             String         @id @default(uuid()) @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  name           String         @db.VarChar(150)
  slug           String         @db.VarChar(150)
  blueprintClass BlueprintClass @default(FIRST_CLASS) @map("blueprint_class")
  category       String         @default("General") @db.VarChar(100)
  description    String?        @db.Text
  iconName       String?        @default("Sparkles") @map("icon_name") @db.VarChar(50)
  isBuiltIn      Boolean        @default(false) @map("is_built_in")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  project            Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fields             BlueprintField[]                @relation("BlueprintFields")
  referencedByFields BlueprintField[]                @relation("TargetBlueprint")
  entities           Entity[]
  columnPreferences  UserBlueprintColumnPreference[]
  invariantRules     InvariantRule[]

  @@unique([projectId, slug])
  @@index([projectId, blueprintClass])
  @@map("blueprints")
}

model BlueprintField {
  id                String             @id @default(uuid()) @db.Uuid
  blueprintId       String             @map("blueprint_id") @db.Uuid
  projectId         String             @map("project_id") @db.Uuid
  name              String             @db.VarChar(100)
  key               String             @db.VarChar(100)
  label             String             @db.VarChar(150)
  fieldType         BlueprintFieldType @map("field_type")
  options           Json               @default("[]") @db.JsonB
  targetBlueprintId String?            @map("target_blueprint_id") @db.Uuid
  minVal            Float?             @map("min_val")
  maxVal            Float?             @map("max_val")
  stepVal           Float?             @map("step_val")
  unit              String?            @db.VarChar(50)
  formulaExpression String?            @map("formula_expression") @db.Text
  isRequired        Boolean            @default(false) @map("is_required")
  orderIndex        Int                @default(0) @map("order_index")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  blueprint       Blueprint  @relation("BlueprintFields", fields: [blueprintId], references: [id], onDelete: Cascade)
  targetBlueprint Blueprint? @relation("TargetBlueprint", fields: [targetBlueprintId], references: [id], onDelete: SetNull)
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([blueprintId, key])
  @@index([blueprintId, orderIndex])
  @@map("blueprint_fields")
}

model UserBlueprintColumnPreference {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  blueprintId    String   @map("blueprint_id") @db.Uuid
  visibleColumns Json     @default("[]") @map("visible_columns") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@unique([userId, blueprintId])
  @@map("user_blueprint_column_preferences")
}

model Entity {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  blueprintId      String   @map("blueprint_id") @db.Uuid
  name             String   @db.VarChar(255)
  aliases          String[] @default([])
  category         String?  @db.VarChar(100)
  description      String?  @db.Text
  properties       Json     @default("{}") @db.JsonB
  computedFormulas Json     @default("{}") @map("computed_formulas") @db.JsonB
  status           String   @default("active") @db.VarChar(50)
  lastMutatedSeq   Int      @default(0) @map("last_mutated_seq")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blueprint           Blueprint            @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  sourceRelationships EntityRelationship[] @relation("SourceEntity")
  targetRelationships EntityRelationship[] @relation("TargetEntity")
  eventEffects        EventEffect[]
  ruleViolations      RuleViolation[]

  @@index([projectId, blueprintId])
  @@map("entities")
}

model EntityRelationship {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  sourceEntityId   String   @map("source_entity_id") @db.Uuid
  targetEntityId   String   @map("target_entity_id") @db.Uuid
  relationshipType String   @map("relationship_type") @db.VarChar(100)
  isBidirectional  Boolean  @default(false) @map("is_bidirectional")
  metadata         Json     @default("{}") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceEntity Entity  @relation("SourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity Entity  @relation("TargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceEntityId, targetEntityId, relationshipType])
  @@map("entity_relationships")
}

model TimelineEvent {
  id                      String        @id @default(uuid()) @db.Uuid
  projectId               String        @map("project_id") @db.Uuid
  narrativeSequenceNumber Int           @map("narrative_sequence_number")
  chronologicalOrder      Int           @map("chronological_order")
  title                   String        @db.VarChar(255)
  description             String?       @db.Text
  anchorSceneId           String?       @map("anchor_scene_id") @db.Uuid
  importanceTier          String        @default("standard") @map("importance_tier") @db.VarChar(50)
  causalPredecessors      String[]      @default([]) @map("causal_predecessors")
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  effects          EventEffect[]
  causedViolations RuleViolation[]

  @@unique([projectId, narrativeSequenceNumber])
  @@index([projectId, chronologicalOrder])
  @@map("timeline_events")
}

model EventEffect {
  id             String          @id @default(uuid()) @db.Uuid
  eventId        String          @map("event_id") @db.Uuid
  projectId      String?         @map("project_id") @db.Uuid
  targetEntityId String          @map("target_entity_id") @db.Uuid
  propertyKey    String          @map("property_key") @db.VarChar(100)
  operation      EffectOperation @default(SET)
  previousValue  Json?           @map("previous_value") @db.JsonB
  newValue       Json            @map("new_value") @db.JsonB
  explanation    String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  event        TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  targetEntity Entity        @relation(fields: [targetEntityId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([targetEntityId])
  @@map("event_effects")
}

model StateSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  chapterId      String?  @map("chapter_id") @db.Uuid
  sequenceNumber Int      @map("sequence_number")
  snapshotData   Json     @map("snapshot_data") @db.JsonB
  checksum       String   @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sequenceNumber])
  @@map("state_snapshots")
}

model InvariantRule {
  id               String            @id @default(uuid()) @db.Uuid
  projectId        String            @map("project_id") @db.Uuid
  name             String            @db.VarChar(255)
  ruleType         String            @default("custom_predicate") @map("rule_type") @db.VarChar(50)
  targetBlueprintId String?          @map("target_blueprint_id") @db.Uuid
  severity         InvariantSeverity @default(BLOCKING_ERROR)
  predicate        Json              @db.JsonB
  description      String?           @db.Text
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetBlueprint Blueprint?      @relation(fields: [targetBlueprintId], references: [id], onDelete: SetNull)
  violations      RuleViolation[]

  @@map("invariant_rules")
}

model RuleViolation {
  id                   String    @id @default(uuid()) @db.Uuid
  projectId            String    @map("project_id") @db.Uuid
  ruleId               String    @map("rule_id") @db.Uuid
  sceneId              String?   @map("scene_id") @db.Uuid
  entityId             String?   @map("entity_id") @db.Uuid
  violatingClaim       String    @map("violating_claim") @db.Text
  canonicalBaseline    String    @map("canonical_baseline") @db.Text
  causalEventId        String?   @map("causal_event_id") @db.Uuid
  suggestedResolutions Json      @default("[]") @map("suggested_resolutions") @db.JsonB
  isResolved           Boolean   @default(false) @map("is_resolved")
  resolutionAction     String?   @map("resolution_action") @db.VarChar(50)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt           DateTime? @map("resolved_at") @db.Timestamptz

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rule        InvariantRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  entity      Entity?        @relation(fields: [entityId], references: [id], onDelete: SetNull)
  scene       Scene?         @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  causalEvent TimelineEvent? @relation(fields: [causalEventId], references: [id], onDelete: SetNull)

  @@index([projectId, isResolved])
  @@map("rule_violations")
}

model Manuscript {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  title     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapters  Chapter[]

  @@map("manuscripts")
}

model Chapter {
  id           String     @id @default(uuid()) @db.Uuid
  manuscriptId String     @map("manuscript_id") @db.Uuid
  title        String     @db.VarChar(255)
  orderIndex   Int        @map("order_index")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  manuscript   Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  scenes       Scene[]

  @@unique([manuscriptId, orderIndex])
  @@map("chapters")
}

model Scene {
  id             String      @id @default(uuid()) @db.Uuid
  chapterId      String      @map("chapter_id") @db.Uuid
  title          String      @db.VarChar(255)
  orderIndex     Int         @map("order_index")
  sequenceNumber Int         @map("sequence_number")
  proseContent   String      @default("") @map("prose_content") @db.Text
  wordCount      Int         @default(0) @map("word_count")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  chapter        Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lease          SceneLease?
  violations     RuleViolation[]

  @@index([chapterId, orderIndex])
  @@map("scenes")
}

model SceneLease {
  sceneId   String   @id @map("scene_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  scene     Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("scene_leases")
}

model AdminOverrideLog {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  adminUserId   String   @map("admin_user_id") @db.Uuid
  actionType    String   @map("action_type") @db.VarChar(100)
  targetId      String   @map("target_id") @db.VarChar(255)
  justification String   @db.Text
  details       Json     @default("{}") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  adminUser     User     @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([projectId, actionType])
  @@map("admin_override_logs")
}
