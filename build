#!/usr/bin/env bash
# ==============================================================================
# NovWrite Build Alias (./build -> ./run.sh build)
# Platform Support: Linux, macOS (Darwin), Windows (Git Bash / MSYS2 / WSL)
# Usage: ./build [options]
# ==============================================================================

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$ROOT_DIR/run.sh" build "$@"
