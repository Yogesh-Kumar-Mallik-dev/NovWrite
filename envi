#!/usr/bin/env bash
# ==============================================================================
# NovWrite Environment Setup Alias (./envi -> ./run.sh envi)
# Platform Support: Linux, macOS (Darwin), Windows (Git Bash / MSYS2 / WSL)
# Usage: ./envi [options]
# ==============================================================================

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$ROOT_DIR/run.sh" envi "$@"
