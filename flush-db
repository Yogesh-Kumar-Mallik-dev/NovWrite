#!/usr/bin/env bash
# ==============================================================================
# NovWrite Flush DB Alias (./flush-db -> ./run.sh flush-db)
# Platform Support: Linux, macOS (Darwin), Windows (Git Bash / MSYS2 / WSL)
# Usage: ./flush-db [options]
# ==============================================================================

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$ROOT_DIR/run.sh" flush-db "$@"
