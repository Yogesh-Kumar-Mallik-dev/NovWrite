{
  "name": "novwrite-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "A Continuity-First Multi-User Novel Creation Platform with a User-Defined Story Universe Engine",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @novwrite/web dev",
    "dev:all": "pnpm --parallel --filter \"@novwrite/*\" dev",
    "dev:web": "pnpm --filter @novwrite/web dev",
    "dev:api": "cd apps/api && go run ./cmd/server/main.go",
    "build": "pnpm --recursive run build",
    "check": "pnpm --filter @novwrite/web check",
    "test": "pnpm --recursive run test && cd apps/api && go test ./...",
    "test:web": "pnpm --filter @novwrite/web test",
    "test:bridge": "pnpm --filter @novwrite/bridge test",
    "test:data": "pnpm --filter @novwrite/data-service test",
    "test:api": "cd apps/api && go test ./...",
    "lint": "pnpm --recursive run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  }
}
